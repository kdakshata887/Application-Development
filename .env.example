# ============================================================
# EduTrack — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# -----------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/school_timetable_attendance_db
DB_USERNAME=postgres
DB_PASSWORD=YourSecurePassword

# -----------------------------------------------------------
# JWT Secret (use a long random string in production)
# Generate one: openssl rand -hex 64
# -----------------------------------------------------------
JWT_SECRET=ChangeThisSuperSecretKeyForJWTSigningInProductionEnvironment123456

# -----------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# -----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------
# Mail (only needed when app.notification.provider=email)
# -----------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# -----------------------------------------------------------
# Notification Provider: mock | email
# "mock" logs notifications to the console (no external service needed)
# -----------------------------------------------------------
APP_NOTIFICATION_PROVIDER=mock

# -----------------------------------------------------------
# Biometric Provider: mock | device
# "mock" simulates biometric events locally
# -----------------------------------------------------------
APP_BIOMETRIC_PROVIDER=mock
